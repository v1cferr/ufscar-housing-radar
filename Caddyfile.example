# Integração com o seu Caddy (dotfiles/caddy/etc/caddy/Caddyfile).
#
# Seu Caddy usa UM bloco curinga `*.v1cferr.dev { ... }` com matchers @host e
# cert wildcard via DNS challenge (Cloudflare). Então NÃO crie um site novo:
# adicione o trecho abaixo DENTRO do bloco `*.v1cferr.dev`, junto aos outros
# projetos, antes do `handle { respond "Subdomínio não configurado" 404 }` final.
# O container do housing-radar escuta em 127.0.0.1:3005 (ver docker-compose.yml).

    # ---- Projetos ----
    @ap host ap.v1cferr.dev
    handle @ap {
        reverse_proxy 127.0.0.1:3005
    }

# --- Variante PRIVADA (login só de fora da LAN, igual ao dash) -------------
# Se preferir não expor seu shortlist publicamente, troque o handle acima por:
#
#     @ap host ap.v1cferr.dev
#     handle @ap {
#         @ap_externo not remote_ip 192.168.1.0/24 127.0.0.1/8 ::1
#         basic_auth @ap_externo {
#             v1cferr {$CADDY_DASH_HASH}   # reaproveita o hash do dash (usuário v1cferr)
#         }
#         reverse_proxy 127.0.0.1:3005
#     }
#
# --- Aplicar -----------------------------------------------------------------
#   /usr/local/bin/caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
# O certificado TLS é automático (curinga *.v1cferr.dev) — nada a configurar.
