# Copie para `.env` e ajuste. Todas as variáveis usam o prefixo HR_.

# Banco de dados (SQLite por padrão; troque por postgres://... quando migrar)
HR_DATABASE_URL=sqlite:///data/housing_radar.db

# Destino de referência: campus da UFSCar São Carlos
HR_UFSCAR_LAT=-21.9839
HR_UFSCAR_LON=-47.8807
HR_DESTINATION_LABEL=UFSCar São Carlos

# Geocoding (Nominatim/OpenStreetMap) — use um e-mail real no user-agent (boa prática / ToS)
HR_NOMINATIM_USER_AGENT=ufscar-housing-radar/0.1 (victor.ferreira@fai.ufscar.br)

# Routing real por modal (opcional). Pegue uma chave grátis em https://openrouteservice.org
# Sem chave, o tempo de deslocamento é estimado por distância em linha reta + velocidade média.
HR_ORS_API_KEY=

# Coleta
HR_COLLECT_MAX_PAGES=5

# URL de busca do OLX (apartamentos à venda em SP).
# OBS: hoje a OLX ignora o slug de região na URL nas nossas requisições (geo por IP),
# então o coletor filtra por cidade-alvo (São Carlos) ao processar. Render baixo até
# resolvermos o filtro de localização real da OLX — use o coletor manual/CSV como base.
HR_OLX_SEARCH_URL=https://www.olx.com.br/imoveis/venda/apartamentos/estado-sp
